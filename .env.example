# Settings of the hosted server (garmin-mcp serve). Copy to .env and fill in;
# docs/hosted.md explains each one. The standalone mode needs none of this.

# Secret: this app's key in MyAuth (the same value as in MyAuth's APP_KEYS).
# With it the server fetches the users' Garmin access tokens from MyAuth. The
# server refuses to start without it.
MYAUTH_APP_KEY=

# MyAuth, as the container reaches it, and the port of its public pages.
MYAUTH_URL=http://myauth:8000
MYAUTH_PUBLIC_PORT=1000
MYAUTH_APP=mcp-garmin

# Public face for the AI clients, and the browser face (account and consent
# pages). Unset, everything uses the host of the request.
PUBLIC_URL=https://mcp.example.com/garmin
MCP_URL=https://mcp.example.com/garmin
UI_URL=https://home.example.com:1030

# Optional: shown in the page footer after the version.
FOOTER_NOTE=
# Fallback only; each user's time zone comes from MyAuth.
TZ=Europe/Berlin
